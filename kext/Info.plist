<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>SAS2308HBA</string>
	<key>CFBundleIdentifier</key>
	<string>org.sas2308.driver.SAS2308HBA</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SAS2308HBA</string>
	<key>CFBundlePackageType</key>
	<string>KEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>27.0</string>
	<key>IOKitPersonalities</key>
	<dict>
		<key>SAS2308</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>org.sas2308.driver.SAS2308HBA</string>
			<key>IOClass</key>
			<string>SAS2308HBA</string>
			<key>IOProviderClass</key>
			<string>IOPCIDevice</string>
			<!-- vendor 0x1000, the SAS2308 ids of FreeBSD's mps_pci.c (D52): 0x0087 SAS2308_2
			     (SAS 9207-8i/-8e, the tested card), 0x0086 SAS2308_1, 0x006E SAS2308_3; same chip
			     and firmware interface. The other MPI2 chips (SAS2004/2008/2108/2116/2208) are
			     left out until tested -->
			<key>IOPCIMatch</key>
			<string>0x00871000 0x00861000 0x006e1000</string>
			<!-- required for a device behind a Thunderbolt PCIe tunnel -->
			<key>IOPCITunnelCompatible</key>
			<true/>
			<key>IOProbeScore</key>
			<integer>1000</integer>
			<!-- log level 0 error, 1 warn, 2 info, 3 debug, 4 trace; boot-arg sas2308_log=N
			     overrides it, sas2308ctl changes it at runtime (docs/design.md "Logging") -->
			<key>SAS2308LogLevel</key>
			<integer>2</integer>
			<!-- FreeBSD loader tunables (hw.mps.X, dev.mps.N.X) are read as mps.X / mps.N.X:
			     a boot-arg of that name first, else a key here (D33). max_io_pages: 256 x 4 KiB
			     = 1 MiB per IO, what IOBlockStorageDriver sends; FreeBSD's default (-1) would
			     size every task for the IOC's 4.5 MiB (1154 segments, ~38 MiB wired) (D32) -->
			<key>mps.max_io_pages</key>
			<integer>256</integer>
			<!-- BAR1 mapped kIOMapPostedWrite (D75 A/B on the 9207 behind the JHL7440: sequential 4K
			     QD32 on 7 drives 177563 IOPS vs 173081 / 173343 non-posted, random 4K and verify
			     unchanged, 0 errors); boot-arg sas2308_posted_write=0 maps it non-posted -->
			<key>sas2308_posted_write</key>
			<integer>1</integer>
			<!-- as Apple's AppleLSIFusionMPT (AppleLSIFusionSAS personality): the family copies
			     Physical Interconnect / Location into the HBA's Protocol Characteristics; the
			     kext copies them and the timeouts (ms) into every target nub's. 60 s: FreeBSD da's
			     DA_DEFAULT_TIMEOUT (scsi_da.c), counted from the post to the IOC as FreeBSD's
			     (D4); no Apple value or drive ERC measurement says otherwise (D15a) -->
			<key>Physical Interconnect</key>
			<string>SAS</string>
			<key>Physical Interconnect Location</key>
			<string>External</string>
			<key>Read Time Out Duration</key>
			<integer>60000</integer>
			<key>Write Time Out Duration</key>
			<integer>60000</integer>
		</dict>
	</dict>
	<key>OSBundleLibraries</key>
	<dict>
		<key>com.apple.iokit.IOPCIFamily</key>
		<string>2.9</string>
		<key>com.apple.iokit.IOSCSIArchitectureModelFamily</key>
		<string>1.0</string>
		<key>com.apple.iokit.IOSCSIParallelFamily</key>
		<string>3.0.0</string>
		<key>com.apple.kpi.bsd</key>
		<string>20.0</string>
		<key>com.apple.kpi.iokit</key>
		<string>20.0</string>
		<key>com.apple.kpi.libkern</key>
		<string>20.0</string>
		<key>com.apple.kpi.mach</key>
		<string>20.0</string>
	</dict>
</dict>
</plist>
